[Unit]
Description=Purin Pi Dashboard
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/purin/pi_keychain
ExecStart=/home/purin/pi_keychain/.venv/bin/python -m app.main
Restart=always
RestartSec=3
User=root
KillSignal=SIGTERM
# E-ink SIGTERM paints "Safe to unplug" (often several seconds); increase if systemd still SIGKILLs.
TimeoutStopSec=60
Environment=PYTHONUNBUFFERED=1
# Optional: PURIN_LOG_LEVEL=DEBUG or PURIN_LOG_HTTP=1 for werkzeug POST lines.
# Environment=PURIN_LOG_LEVEL=DEBUG
# Optional: force gpiozero’s lgpio backend on Bookworm (after: apt install python3-lgpio)
# Environment=GPIOZERO_PIN_FACTORY=lgpio
# systemd runs as root: Path.home() is /root — point explicitly at purin's Waveshare clone.
Environment=PURIN_EPAPER_LIB=/home/purin/e-Paper/RaspberryPi_JetsonNano/python/lib

[Install]
WantedBy=multi-user.target
